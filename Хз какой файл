<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BriScript 0.1</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #080808;
    color: #fff;
    font-family: Arial, sans-serif;
}

header {
    height: 64px;
    border-bottom: 2px solid #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
}

.logo {
    font-size: 24px;
    font-weight: 900;
}

.version {
    border: 2px solid #fff;
    padding: 8px 12px;
    font-size: 13px;
}

main {
    max-width: 1200px;
    margin: auto;
    padding: 18px;
}

.top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
}

h1 {
    margin: 0;
    font-size: 28px;
}

button {
    background: #fff;
    color: #000;
    border: 2px solid #fff;
    padding: 11px 18px;
    font-weight: 900;
    cursor: pointer;
}

button:hover {
    background: #000;
    color: #fff;
}

.editor {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

.box {
    border: 2px solid #fff;
    min-height: 450px;
}

.box-title {
    border-bottom: 2px solid #fff;
    padding: 11px;
    font-weight: 900;
}

textarea {
    width: 100%;
    height: 400px;
    resize: vertical;
    border: 0;
    outline: none;
    background: #111;
    color: #fff;
    padding: 15px;
    font-family: monospace;
    font-size: 15px;
    line-height: 1.6;
}

#output {
    padding: 15px;
    min-height: 400px;
    white-space: pre-wrap;
    font-family: monospace;
    line-height: 1.6;
}

.help {
    margin-top: 15px;
    border: 2px solid #fff;
    padding: 15px;
}

.help h2 {
    margin-top: 0;
}

.rule {
    padding: 7px 0;
    border-bottom: 1px solid #444;
}

code {
    color: #fff;
    font-family: monospace;
}

.error {
    color: #ff5555;
}

.success {
    color: #55ff88;
}

@media (max-width: 700px) {
    .editor {
        grid-template-columns: 1fr;
    }

    .box {
        min-height: 350px;
    }

    textarea,
    #output {
        min-height: 300px;
    }

    .top {
        align-items: stretch;
        flex-direction: column;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">BriScript</div>
    <div class="version">0.1</div>
</header>

<main>

    <div class="top">
        <h1>Редактор BriScript</h1>
        <button onclick="runBriScript()">▶ Запустить</button>
    </div>

    <div class="editor">

        <section class="box">
            <div class="box-title">КОД BRI</div>

            <textarea id="code">{
show <> "Привет,_мир!"
:
show <> "Добро_пожаловать_в_BriScript!"
(
</textarea>
        </section>

        <section class="box">
            <div class="box-title">РЕЗУЛЬТАТ</div>

            <div id="output"></div>
        </section>

    </div>

    <section class="help">
        <h2>Правила BriScript 0.1</h2>

        <div class="rule">
            <code>{ }</code> — основной блок кода
        </div>

        <div class="rule">
            <code>:</code> — начать следующую часть скрипта
        </div>

        <div class="rule">
            <code>(</code> — закончить скрипт
        </div>

        <div class="rule">
            <code>)</code> — начать новый скрипт
        </div>

        <div class="rule">
            <code>&lt;&gt;</code> — связать команду со значением
        </div>

        <div class="rule">
            <code>_</code> — пробел в тексте
        </div>

        <div class="rule">
            <code>" "</code> — текст
        </div>

        <div class="rule">
            <code>show</code> — показать текст
        </div>

        <div class="rule">
            <code>click link</code> — создать нажимаемую ссылку
        </div>
    </section>

</main>

<script>
function runBriScript() {
    const code = document.getElementById("code").value;
    const output = document.getElementById("output");

    output.innerHTML = "";

    try {
        interpret(code, output);
    } catch (error) {
        output.innerHTML =
            '<div class="error">Ошибка: ' +
            escapeHTML(error.message) +
            '</div>';
    }
}

function interpret(code, output) {

    code = code.trim();

    if (!code) {
        throw new Error("Код пустой.");
    }

    if (!code.startsWith("{")) {
        throw new Error("Код должен начинаться с {");
    }

    if (!code.includes("(")) {
        throw new Error("Не найден конец скрипта (");
    }

    const start = code.indexOf("{");
    const end = code.lastIndexOf("(");

    if (end <= start) {
        throw new Error("Неправильная структура скрипта.");
    }

    let inside = code.substring(start + 1, end);

    /*
        :
        разделяет части скрипта
    */

    const parts = inside
        .split(":")
        .map(part => part.trim())
        .filter(part => part.length > 0);

    for (const part of parts) {
        executePart(part, output);
    }
}

function executePart(part, output) {

    const lines = part
        .split("\n")
        .map(line => line.trim())
        .filter(line => line.length > 0);

    for (const line of lines) {

        /*
            SHOW
        */

        if (line.startsWith("show")) {

            const match = line.match(
                /^show\s*<>\s*"([\s\S]*)"$/
            );

            if (!match) {
                throw new Error(
                    'Неправильный синтаксис show: ' + line
                );
            }

            let text = match[1];

            /*
                _ превращается в обычный пробел
            */

            text = text.replace(/_/g, " ");

            const div = document.createElement("div");
            div.textContent = text;

            output.appendChild(div);

            continue;
        }

        /*
            CLICK LINK
        */

        if (line.startsWith("click link")) {

            const match = line.match(
                /^click\s+link\s*<>\s*"([^"]+)"$/
            );

            if (!match) {
                throw new Error(
                    'Неправильный синтаксис click link: ' + line
                );
            }

            const url = match[1];

            const link = document.createElement("a");

            link.href = url;
            link.target = "_blank";
            link.rel = "noopener noreferrer";

            link.textContent = url;

            link.style.display = "block";
            link.style.color = "#fff";
            link.style.margin = "8px 0";
            link.style.textDecoration = "underline";

            output.appendChild(link);

            continue;
        }

        /*
            НЕИЗВЕСТНАЯ КОМАНДА
        */

        throw new Error(
            "Неизвестная команда: " + line
        );
    }
}

function escapeHTML(text) {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
}

/*
    Ctrl + Enter = запуск
*/

document.getElementById("code").addEventListener(
    "keydown",
    function(event) {

        if (event.ctrlKey && event.key === "Enter") {
            event.preventDefault();
            runBriScript();
        }

    }
);
</script>

</body>
</html>
